{
	"name": "pl_logistic_master_data_process",
	"properties": {
		"activities": [
			{
				"name": "Act-Set-Pipeline-Start-Time",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "V_Pipeline_Start_Time",
					"value": {
						"value": "@utcNow()",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Act-Set-Master-Pipeline-Run-Id",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "V_Master_Pipeline_Run_Id",
					"value": {
						"value": "@pipeline().RunId",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Act-Lookup-Get-Last-Run-Completed-Status",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "Act-Set-Pipeline-Start-Time",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Act-Set-Master-Pipeline-Run-Id",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.00:10:00",
					"retry": 1,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT is_last_run_completed FROM METADATA.pipeline_run_status WHERE PIPELINE_NAME = '@{pipeline().Pipeline}'",
							"type": "Expression"
						},
